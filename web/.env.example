# Every variable listed here is enforced at app boot by `web/lib/env.ts`.
# To add a new env var: declare it in the schema there, then add it to this file.
# Required vars cause the app to refuse to boot if missing; optional vars are read lazily.

# === Required ===

# Supabase (project URL + keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API (used by every AI call site)
GEMINI_API_KEY=your-gemini-api-key

# Vercel Cron auth — used by /api/cron/** and /api/internal/**
CRON_SECRET=generate-a-long-random-string

# Resend (transactional email — weekly digest, feedback notifications)
RESEND_API_KEY=re_xxx

# === Optional ===

# Public URL (used in email templates and absolute links). Defaults to the
# Vercel preview URL if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend "from" address. Defaults to onboarding@resend.dev for local dev.
RESEND_FROM=brief@yourdomain.com

# GitHub integration (feedback -> issues + auto-implement workflow). Required
# only if the feedback package's GitHub features are used.
GJ_GITHUB_TOKEN=ghp_xxx
GJ_GITHUB_OWNER=your-org
GJ_GITHUB_REPO=your-repo

# Set to "1" to disable Gemini telemetry writes (useful for one-off scripts).
GEMINI_TELEMETRY_DISABLED=

# Open-model evaluation harness (scripts/model-bakeoff.ts) — EVAL ONLY, not
# used by the app at runtime. Fireworks is a US-based OpenAI-compatible host for
# the GLM-5.2 / DeepSeek V4-Flash bake-off against the Gemini baseline. See
# docs/OPEN_MODEL_EVALUATION.md. The candidate model ids/slugs live in
# web/lib/ai/providers/registry.ts; override the provider slugs here if they rotate.
FIREWORKS_API_KEY=fw_xxx
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_GLM_MODEL=
FIREWORKS_DEEPSEEK_MODEL=

# Set to "true" to log successful cron auth attempts (useful for debugging).
LOG_CRON_AUTH=

# Sentry — server-side only (no NEXT_PUBLIC_ prefix; browser SDK is out of
# scope). DSN is REQUIRED in production: web/lib/env.ts throws at startup
# when VERCEL_ENV=production and SENTRY_DSN is unset.
SENTRY_DSN=
# Optional. Defaults to VERCEL_ENV ?? "development".
SENTRY_ENVIRONMENT=

# Daily Gemini cost alarm. /api/admin/cost-alarm reads the last 24h of
# gemini_usage_events and fires Sentry.captureMessage if ANY of three
# independent tripwires trips (USD estimate under-counts grounding ~2.7x, so
# the count + token wires page even when the dollar number is wrong).
# Defaults: 50 USD / 500 grounded calls / 15,000,000 tokens. Tune to ~1.5-2x
# your observed daily norms.
GEMINI_DAILY_USD_THRESHOLD=
GEMINI_DAILY_GROUNDED_CALL_THRESHOLD=
GEMINI_DAILY_TOKEN_THRESHOLD=
