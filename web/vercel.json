      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/companies/[id]/insights/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/companies/test/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/companies/detect/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
