      "location": "{city|null,country}|null — from title+description only (the prompt never sees the ATS location field)",
      "tech_required": [
        "string | string[] (synonyms)"
      ],
      "tech_allowed": [
        "string"
      ]
    },
    "acceptable": {
      "<field>": [
        "alternative values"
      ]
    }
  },
